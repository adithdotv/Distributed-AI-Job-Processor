# Copy to backend/.env.docker (Docker) or backend/.env (local) and fill in real values.
DATABASE_URL=postgresql+psycopg://job_processor:<password>@postgres:5432/job_processor
REDIS_URL=redis://redis:6379/0
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite

# Root .env: read by Docker Compose to fill ${POSTGRES_PASSWORD} in docker-compose.yml.
POSTGRES_PASSWORD=<same-password-as-your-existing-database>
